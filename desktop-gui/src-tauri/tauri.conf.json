{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamDeck Configurator",
  "version": "0.1.0",
  "identifier": "com.streamdeck.configurator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label":         "main",
        "url":           "index.html",
        "title":         "StreamDeck Configurator",
        "width":         1000,
        "height":        660,
        "minWidth":      800,
        "minHeight":     520,
        "resizable":     true,
        "decorations":   true,
        "transparent":   true,
        "fullscreen":    false,
        "alwaysOnTop":   false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active":    true,
    "targets":   "all",
    "icon":      ["icons/icon.png"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
